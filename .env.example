# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# JWT Access Token
JWT_ACCESS_SECRET="change-me-to-a-long-random-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

# JWT Refresh Token
JWT_REFRESH_SECRET="change-me-to-a-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins; no wildcards in production)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Swagger (defaults to enabled in development, disabled in production)
SWAGGER_ENABLED=true
